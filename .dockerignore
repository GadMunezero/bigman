# Keeps the build context small and, more importantly, keeps a local database
# out of the image. The container's database lives on the volume at
# DATABASE_PATH (/data/app.db) and is created on first boot; a stray app.db
# baked into /app/data would be dead weight that looks authoritative.
node_modules
.next
.git
.gitignore
.github

data/app.db
data/app.db-shm
data/app.db-wal

# Build output of the offline single-file artifact — unrelated to the server.
tools/standalone/build

*.log
npm-debug.log*
.DS_Store
