# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it.
#
#   cp deploy/.env.example deploy/.env

# Your domain, without https:// and without www. Caddy serves both this and
# the www variant, so both must point at this server in DNS.
SITE_DOMAIN=example.com

# Let's Encrypt uses this only to warn you before a certificate expires.
ACME_EMAIL=you@example.com

# The full public URL, used for canonical links, the sitemap and robots.txt.
# Must include https:// and match SITE_DOMAIN.
NEXT_PUBLIC_SITE_URL=https://example.com

# Guards /admin. Generate one rather than inventing it:
#   openssl rand -base64 24
#
# With this unset, /admin is LOCKED, not open — but then nothing can be
# verified or published either, and the catalogue ships as draft.
ADMIN_PASSWORD=

# Publishes the seeded catalogue on first boot. Leave this unset.
# The catalogue is unverified research; publishing it wholesale puts figures
# in front of traders that nobody has checked against the firm's own page.
# SEED_PUBLISH=1
