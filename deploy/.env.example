# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it.
#
#   cp deploy/.env.example deploy/.env

# Your domain, without https:// and without www. Caddy serves both this and
# the www variant, so both must point at this server in DNS.
SITE_DOMAIN=example.com

# Let's Encrypt uses this only to warn you before a certificate expires.
ACME_EMAIL=you@example.com

# The full public URL, used for canonical links, the sitemap and robots.txt.
# Must include https:// and match SITE_DOMAIN.
NEXT_PUBLIC_SITE_URL=https://example.com

# Guards /admin. Generate one rather than inventing it:
#   openssl rand -base64 24
#
# With this unset, /admin is LOCKED, not open — but then nothing can be
# verified or published either, and the catalogue ships as draft.
ADMIN_PASSWORD=

# What goes live on first boot. Leave this unset — the default is what you want.
#
# Unset (or 'ready') publishes the 113 challenges that carry every figure the
# engine scores on: price, max drawdown, drawdown type, profit target and
# profit split. The other 211 stay as drafts you can finish in /admin. The site
# says on the results page and every challenge page how much of it has been
# checked against a firm's own page, so nothing claims to be verified.
#
#   none   publish nothing — an empty site until you publish by hand
#   all    publish all 324, gaps included. A challenge with no price still gets
#          a match score, which is a guess wearing a number. Not recommended.
#
# SEED_PUBLISH=ready
