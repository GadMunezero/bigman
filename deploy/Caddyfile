# Caddy fetches and renews the TLS certificate itself, so there is no certbot
# and no renewal cron job to forget about.
#
# SITE_DOMAIN and ACME_EMAIL come from deploy/.env.

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	# Admin is password-protected by the app itself, but it has no business
	# being indexed or framed, and it should never be served from a cache.
	@admin path /admin*
	header @admin {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
	}

	header {
		# HSTS is deliberately not preloaded. Preloading is effectively
		# irreversible, and this is a domain you may still be moving around.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /
		health_interval 30s
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
